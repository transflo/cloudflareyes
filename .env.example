# 复制为 .env 并填写实际值: cp .env.example .env
# 腾讯云 API 密钥（必填）: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key

# 要更新的域名与主机记录（必填）
DOMAIN=example.com
SUBDOMAIN=@

# 需要维护的线路（逗号分隔，需与 DNSPod 线路名一致）
LINES=电信,联通,移动

# 每条线路最多同步页面排名前 N 个 IPv4，默认固定为 3 个位置
MAX_IPS_PER_LINE=3

# 更新间隔（分钟），优选数据约每 10 分钟更新一次
INTERVAL_MINUTES=10

# 记录 TTL（秒）
TTL=600

# 只打印将要执行的变更，不真正修改解析记录（true/false）
DRY_RUN=false

# 跑一次就退出，便于手动验证（true/false）
RUN_ONCE=false

# 日志级别: DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# HTTP 请求超时时间（秒）
HTTP_TIMEOUT=90

# FlareSolverr 单次浏览器请求最大超时（毫秒）
FLARE_MAX_TIMEOUT=60000

# FlareSolverr 地址（compose 内默认 http://flaresolverr:8191）
FLARESOLVERR_URL=http://flaresolverr:8191

# DNSPod API 地址；生产环境保持默认官方地址，本地集成测试可指向 mock 服务
DNSPOD_ENDPOINT=https://dnspod.tencentcloudapi.com

# 抓取目标页面
TARGET_URL=https://api.uouin.com/cloudflare.html

# 可选：使用 Docker Hub 镜像部署时，设置为 <DockerHub用户名>/cloudflareyes:latest
# DOCKER_IMAGE=transflo/cloudflareyes:latest
